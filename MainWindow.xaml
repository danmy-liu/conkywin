<Window x:Class="ConkyWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="False" SizeToContent="Height" Width="220"
        Left="1680" Top="360" Loaded="OnLoaded" Closed="OnClosed">
    <Window.Resources>
        <LinearGradientBrush x:Key="BarCpu" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4DE3E0" Offset="0"/>
            <GradientStop Color="#2F9EFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BarMem" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6FA8FF" Offset="0"/>
            <GradientStop Color="#9B7BFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BarDisk" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFC85C" Offset="0"/>
            <GradientStop Color="#FF8A5C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BarGpu" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#B78CFF" Offset="0"/>
            <GradientStop Color="#7A5CFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    <StackPanel x:Name="RootPanel" Margin="12,10,12,10">
        <!-- 标题行 -->
        <Grid Margin="0,0,0,6">
            <TextBlock Text="S Y S T E M" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#8FD8FF" VerticalAlignment="Center"/>
            <TextBlock x:Name="TimeVal" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#EAF2FC" VerticalAlignment="Center"/>
        </Grid>

        <!-- CPU -->
        <Grid Margin="0,2,0,0">
            <TextBlock x:Name="LabelCpu" Text="CPU" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#7A90AC" VerticalAlignment="Center"/>
            <TextBlock x:Name="CpuVal" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#4DE3E0" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="CpuBarBg" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,3,0,0">
            <Rectangle x:Name="CpuBar" RadiusX="2" RadiusY="2" Fill="{StaticResource BarCpu}" HorizontalAlignment="Left" Width="0"/>
        </Border>

        <!-- 内存 -->
        <Grid Margin="0,7,0,0">
            <TextBlock x:Name="LabelMem" Text="MEM" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#7A90AC" VerticalAlignment="Center"/>
            <TextBlock x:Name="MemVal" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#7FB0FF" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="MemBarBg" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,3,0,0">
            <Rectangle x:Name="MemBar" RadiusX="2" RadiusY="2" Fill="{StaticResource BarMem}" HorizontalAlignment="Left" Width="0"/>
        </Border>

        <!-- 磁盘 -->
        <Grid Margin="0,7,0,0">
            <TextBlock x:Name="LabelDisk" Text="DISK" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#7A90AC" VerticalAlignment="Center"/>
            <TextBlock x:Name="DiskVal" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FFC85C" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="DiskBarBg" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,3,0,0">
            <Rectangle x:Name="DiskBar" RadiusX="2" RadiusY="2" Fill="{StaticResource BarDisk}" HorizontalAlignment="Left" Width="0"/>
        </Border>

        <!-- 网络 -->
        <Grid Margin="0,7,0,0">
            <TextBlock x:Name="LabelNet" Text="NET" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#7A90AC" VerticalAlignment="Center"/>
            <TextBlock x:Name="NetVal" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#8FD8FF" VerticalAlignment="Center"/>
        </Grid>

        <!-- GPU -->
        <Grid Margin="0,7,0,0">
            <TextBlock x:Name="LabelGpu" Text="GPU" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#7A90AC" VerticalAlignment="Center"/>
            <TextBlock x:Name="GpuVal" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#B78CFF" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="GpuBarBg" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,3,0,0">
            <Rectangle x:Name="GpuBar" RadiusX="2" RadiusY="2" Fill="{StaticResource BarGpu}" HorizontalAlignment="Left" Width="0"/>
        </Border>

        <!-- CPU 温度 -->
        <Grid Margin="0,7,0,0">
            <TextBlock x:Name="LabelTemp" Text="TEMP" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#7A90AC" VerticalAlignment="Center"/>
            <TextBlock x:Name="TempVal" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF6B6B" VerticalAlignment="Center"/>
        </Grid>

        <!-- 进程数 -->
        <Grid Margin="0,7,0,0">
            <TextBlock x:Name="LabelProc" Text="PROC" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#7A90AC" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProcVal" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#EAF2FC" VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</Window>
