<Window x:Class="ConkyWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConkyWin 设置" Width="780" Height="660" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource UiBg}"
        Closing="OnClosing">
    <Window.Resources>
        <!-- 画刷对象在代码里创建、切换主题时只改 Color，所有引用会实时更新 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource UiFieldText}"/>
            <Setter Property="Background" Value="{DynamicResource UiInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
            <Setter Property="Background" Value="{DynamicResource UiBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UiBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- ComboBox 必须自带模板：系统默认模板用的是 Windows 浅色画刷，
             深色主题下会变成「白底 + 浅色字」，选中值看不见。 -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource UiFieldText}"/>
            <Setter Property="Background" Value="{DynamicResource UiInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="3" SnapsToDevicePixels="True"
                                                Background="{DynamicResource UiInputBg}"
                                                BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Fill="{DynamicResource UiText}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource UiFieldText}"/>
                            <Popup x:Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border x:Name="DropDown" SnapsToDevicePixels="True"
                                        Background="{DynamicResource UiPanel}"
                                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource UiFieldText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Padding="7,4" SnapsToDevicePixels="True"
                                Background="{DynamicResource UiPanel}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UiTabHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UiTabActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource UiTabText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{DynamicResource UiTabBg}"
                                BorderBrush="{DynamicResource UiBorder}"
                                BorderThickness="1,1,1,0" CornerRadius="4,4,0,0"
                                Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UiTabActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UiTabHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource UiHeader}" Padding="22,14"
                BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="外观" FontSize="12" Foreground="{DynamicResource UiTextSub}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ThemePicker" Width="118" SelectionChanged="OnUiThemeChanged">
                        <ComboBoxItem Content="浅色" Tag="light"/>
                        <ComboBoxItem Content="深色" Tag="dark"/>
                        <ComboBoxItem Content="跟随系统" Tag="system"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="ConkyWin 设置" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource UiText}"/>
                    <TextBlock Text="修改后自动保存，约 1 秒后面板生效；所有自定义键都会原样保留"
                               FontSize="12" Foreground="{DynamicResource UiTextSub}" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,10,12,4">
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel x:Name="GeneralPanel" Margin="6"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="配色">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel x:Name="ColorsPanel" Margin="6"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="字体">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel x:Name="FontsPanel" Margin="6"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="脚本参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel x:Name="ScriptPanel" Margin="6"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Lua 脚本">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="主题" Margin="0,0,10,0"/>
                        <ComboBox x:Name="ThemeBox" Width="130" SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="color（彩色）" Tag="color"/>
                            <ComboBoxItem Content="mono（单色）" Tag="mono"/>
                        </ComboBox>
                        <TextBlock x:Name="LuaStatus" Text="" Foreground="{DynamicResource UiTextSub}" Margin="16,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnCheckLua" Content="语法检查" Click="OnCheckLua"/>
                        <Button x:Name="BtnSaveLua" Content="保存脚本" Margin="8,0,0,0" Click="OnSaveLua"/>
                        <Button x:Name="BtnRestoreLua" Content="恢复默认脚本" Margin="8,0,0,0" Click="OnRestoreLua"/>
                    </StackPanel>
                    <TextBox x:Name="LuaEditor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" TextChanged="OnLuaTextChanged"/>
                    <TextBlock Grid.Row="3" Text="脚本保存后 1 秒自动重载；语法错误只会在 debug.log 记录，面板会回退到内置样式"
                               FontSize="11" Foreground="{DynamicResource UiTextSub}" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="原始 JSON">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnApplyRaw" Content="校验并应用" Click="OnApplyRaw"/>
                        <Button x:Name="BtnReloadRaw" Content="重新载入" Margin="8,0,0,0" Click="OnReloadRaw"/>
                        <Button x:Name="BtnRestoreBackup" Content="还原备份" Margin="8,0,0,0" Click="OnRestoreBackup"/>
                    </StackPanel>
                    <TextBox x:Name="RawEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" TextChanged="OnRawTextChanged"/>
                    <TextBlock Grid.Row="2" Text="这里能改任意自定义键；未知键不会被上面的控件删掉"
                               FontSize="11" Foreground="{DynamicResource UiTextSub}" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource UiHeader}" Padding="16,12"
                BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource UiTextSub}"
                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnOpenFolder" Content="打开所在文件夹" Click="OnOpenFolder"/>
                    <Button x:Name="BtnRestoreDefault" Content="恢复默认配置" Margin="8,0,0,0" Click="OnRestoreDefault"/>
                    <Button x:Name="BtnSave" Content="保存并应用" Margin="8,0,0,0" Click="OnSave"/>
                    <Button x:Name="BtnClose" Content="关闭" Margin="8,0,0,0" Click="OnClose"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
