<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>assets\conkywin.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ConkyWin</AssemblyName>
    <RootNamespace>ConkyWin</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <Version>1.1.0</Version>
    <Product>ConkyWin</Product>
    <Description>Conky-style desktop system monitor widget for Windows, built with WPF.</Description>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <!-- dist 下会生成发行包与临时工具，别让 SDK 把里面的 .cs 示例当源码编译 -->
    <Compile Remove="dist\**\*.cs" />
    <None Remove="dist\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 天气图标等资源：编译时复制到输出目录，Lua 脚本按相对路径引用 -->
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 配置窗口「恢复默认」用的内置模板（编译进 exe，发行包无需额外文件） -->
    <EmbeddedResource Include="config.example.json" LogicalName="ConkyWin.Defaults.config.json" />
    <EmbeddedResource Include="script.harmattan.lua" LogicalName="ConkyWin.Defaults.script.lua" />
  </ItemGroup>
</Project>
